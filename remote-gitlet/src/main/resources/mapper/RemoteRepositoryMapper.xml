<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.openapitools.mapper.RemoteRepositoryMapper">
    <select id="getRepositoryId" resultType="java.lang.Long">
        SELECT id
        FROM repository
        WHERE owner_id = #{ownerId}
          AND name = #{repo}
    </select>
</mapper>
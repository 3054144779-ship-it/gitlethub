<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="org.openapitools.mapper.RemoteSubmissionRecordMapper">
    <select id="getSubmissionRecordByCommitSha" resultType="java.lang.Boolean">
        SELECT EXISTS (SELECT 1 FROM submission_record WHERE commit_sha = #{commitSha})
    </select>
</mapper>
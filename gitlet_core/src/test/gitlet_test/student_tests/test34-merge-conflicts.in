# Create two branches and merge other into master with a merge conflict.

# 展开 prelude1.inc 初始化定义
> init
<<<
D DATE "Date: \w\w\w \w\w\w \d+ \d\d:\d\d:\d\d \d\d\d\d [-+]\d\d\d\d"
D COMMIT_HEAD "commit ([a-f0-9]+)[ \t]*\n(?:Merge:\s+[0-9a-f]{7}\s+[0-9a-f]{7}[ ]*\n)?${DATE}"
D COMMIT_LOG "(===[ ]*\ncommit [a-f0-9]+[ ]*\n(?:Merge:\s+[0-9a-f]{7}\s+[0-9a-f]{7}[ ]*\n)?${DATE}[ ]*\n(?:.|\n)*?(?=\Z|\n===))"
D ARBLINE "[^\n]*(?=\n|\Z)"
D ARBLINES "(?:(?:.|\n)*(?:\n|\Z)|\A|\Z)"

# 展开 setup1.inc 初始化文件
+ f.txt wug.txt
+ g.txt notwug.txt
> add g.txt
<<<
> add f.txt
<<<

# 展开 setup2.inc 生成初始提交
> commit "Two files"
<<<

# 测试核心执行逻辑
> branch other
<<<
+ h.txt test2.txt
> add h.txt
<<<
> rm g.txt
<<<
+ f.txt test2.txt
> add f.txt
<<<
> commit "Add h.txt, remove g.txt, and change f.txt"
<<<
> checkout other
<<<
+ f.txt notwug.txt
> add f.txt
<<<
+ k.txt test3.txt
> add k.txt
<<<
> commit "Add k.txt and modify f.txt"
<<<
> checkout master
<<<
> log
===
${COMMIT_HEAD}
${ARBLINES}
<<<*
D MASTER_HEAD "${1}"
> merge other
Encountered a merge conflict.
<<<
* g.txt
= h.txt test2.txt
= k.txt test3.txt
# = f.txt conflict1.txt
> log
${COMMIT_LOG}
===
commit ${MASTER_HEAD}
${ARBLINES}
<<<*
> status
=== Branches ===
\*master
other

=== Staged Files ===

=== Removed Files ===

=== Modifications Not Staged For Commit ===

=== Untracked Files ===

<<<*
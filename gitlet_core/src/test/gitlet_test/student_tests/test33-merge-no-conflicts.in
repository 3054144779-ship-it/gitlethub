# 创建两个分支，合并其他组成主体。

# 展开 prelude1.inc 初始化定义
> init
<<<
D DATE "Date: \w\w\w \w\w\w \d+ \d\d:\d\d:\d\d \d\d\d\d [-+]\d\d\d\d"
D COMMIT_HEAD "commit ([a-f0-9]+)[ \t]*\n(?:Merge:\s+[0-9a-f]{7}\s+[0-9a-f]{7}[ ]*\n)?${DATE}"
D COMMIT_LOG "(===[ ]*\ncommit [a-f0-9]+[ ]*\n(?:Merge:\s+[0-9a-f]{7}\s+[0-9a-f]{7}[ ]*\n)?${DATE}[ ]*\n(?:.|\n)*?(?=\Z|\n===))"
D ARBLINE "[^\n]*(?=\n|\Z)"
D ARBLINES "(?:(?:.|\n)*(?:\n|\Z)|\A|\Z)"

# 展开 setup1.inc 初始化文件
+ f.txt wug.txt
+ g.txt notwug.txt
> add g.txt
<<<
> add f.txt
<<<

# 展开 setup2.inc 生成初始提交
> commit "Two files"
<<<

# 测试核心执行逻辑
> branch other
<<<
+ h.txt test2.txt
> add h.txt
<<<
> rm g.txt
<<<
> commit "Add h.txt and remove g.txt"
<<<
> checkout other
<<<
> rm f.txt
<<<
+ k.txt test3.txt
> add k.txt
<<<
> commit "Add k.txt and remove f.txt"
<<<
> checkout master
<<<
> merge other
<<<
* f.txt
* g.txt
= h.txt test2.txt
= k.txt test3.txt
> log
===
${COMMIT_HEAD}
Merged other into master\.

${ARBLINES}
<<<*
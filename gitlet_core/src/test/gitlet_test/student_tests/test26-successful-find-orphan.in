# Test the find command when it finds commits that are no longer
# on any branch.

# 展开 prelude1.inc 初始化定义
> init
<<<
D DATE "Date: \w\w\w \w\w\w \d+ \d\d:\d\d:\d\d \d\d\d\d [-+]\d\d\d\d"
D COMMIT_HEAD "commit ([a-f0-9]+)[ \t]*\n(?:Merge:\s+[0-9a-f]{7}\s+[0-9a-f]{7}[ ]*\n)?${DATE}"
D COMMIT_LOG "(===[ ]*\ncommit [a-f0-9]+[ ]*\n(?:Merge:\s+[0-9a-f]{7}\s+[0-9a-f]{7}[ ]*\n)?${DATE}[ ]*\n(?:.|\n)*?(?=\Z|\n===))"
D ARBLINE "[^\n]*(?=\n|\Z)"
D ARBLINES "(?:(?:.|\n)*(?:\n|\Z)|\A|\Z)"

# 展开 setup1.inc 初始化文件
+ f.txt wug.txt
+ g.txt notwug.txt
> add g.txt
<<<
> add f.txt
<<<

# 展开 setup2.inc 生成初始提交
> commit "Two files"
<<<

# 测试核心执行逻辑
> rm f.txt
<<<
> commit "Remove one file"
<<<
> log
===
${COMMIT_HEAD}
Remove one file

===
${COMMIT_HEAD}
Two files

===
${COMMIT_HEAD}
initial commit

<<<*
# UID of initial version
D UID1 "${3}"
# UID of second version
D UID2 "${2}"
# UID of third version
D UID3 "${1}"
> reset ${2}
<<<
> find "Remove one file"
${UID3}
<<<
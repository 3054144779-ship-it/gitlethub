# This makefile is defined to give you the following targets:
#
#    default: Same as check
#    compile: Compile the gitlet application into ./build.
#    check: Compile, then run the integration tests.
#    clean: Remove all files and directories generated by testing.
#
# The gitlet sources live in ../../main/java/gitlet and are compiled into
# ./build, which is what the tester is pointed at via --progdir.  Run these
# targets from this directory.

SHELL = /bin/bash

# Flags to Java compiler: include debugging info, report dubious code.  The
# sources are UTF-8, but javac otherwise assumes the platform encoding.
JFLAGS = -g -encoding UTF-8 -Xlint:unchecked -Xlint:deprecation

# See comment in ../../main/java/gitlet/Makefile
PYTHON = python3

# Root of the gitlet package tree, and the directory to compile into.
GITLET_DIR := $(abspath ../../main/java/gitlet)
PROG_DIR := $(abspath build)

# gitlet.commit.Commit is annotated with Lombok's @Data, and the accessors it
# generates only exist if javac runs Lombok as an annotation processor, so its
# jar has to be on the classpath.  Take the newest copy from the local Maven
# repository; override with make LOMBOK=/path/to/lombok.jar.
M2_REPO ?= $(abspath $(HOME)/.m2/repository)
LOMBOK ?= $(shell ls -1 "$(M2_REPO)/org/projectlombok/lombok"/*/lombok-[0-9]*.jar 2>/dev/null \
                   | grep -v -- '-sources' | sort -V | tail -1)

SRCS := $(shell find "$(GITLET_DIR)" -name '*.java')

TESTER = $(PYTHON) tester.py --progdir="$(PROG_DIR)"

TESTS = samples/*.in student_tests/*.in *.in

.PHONY: default compile check clean

# First, and therefore default, target.
default: check

compile:
	@test -n "$(LOMBOK)" || \
	  { echo "No lombok.jar under $(M2_REPO); rerun as 'make LOMBOK=/path/to/lombok.jar'"; exit 1; }
	@echo "Compiling gitlet.Main..."
	@javac $(JFLAGS) -d "$(PROG_DIR)" -cp "$(dir $(GITLET_DIR));$(LOMBOK)" $(SRCS)

check: compile
	@echo "Testing application gitlet.Main..."
	$(TESTER) $(TESTS)

# 'make clean' will clean up stuff you can reconstruct.
clean:
	$(RM) -r build __pycache__ *_[0-9] *_[0-9][0-9] */*~ *~

<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.huahuo</groupId>
        <artifactId>gitlethub</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>

    <artifactId>gitlet_core</artifactId>
    <name>gitlet_core</name>

    <!--
      gitlet_core is a plain library: no Spring, no web, no database.  It is used
      both by the CLI entry point (gitlet.Main, run as a bare JVM and also
      compiled directly by src/test/gitlet_test/Makefile with only lombok on the
      classpath) and, later, by the gateway.  Keep it dependency-light.

      No <properties> here: spring-boot-starter-parent already sets
      java.version=17, maven.compiler.release and project.build.sourceEncoding=UTF-8,
      all of which this module inherits.
    -->
    <dependencies>
        <!-- gitlet.commit.Commit uses @Data; the version comes from the parent. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <!--OpenFeign-->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!--hutool-->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <!-- ===== 以下为 OpenAPI 生成的 BO 类所需的依赖 ===== -->
        <!--Jackson 注解: @JsonProperty / @JsonCreator / @JsonValue-->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!--Jakarta Validation 注解: @NotNull / @Valid / @Pattern-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--Swagger 注解: @Schema-->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.22</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- 强制跳过此模块的 Spring Boot 打包行为 -->
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

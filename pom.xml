<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.huahuo</groupId>
    <artifactId>gitlethub</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>gitlethub</name>
    <description>gitlethub</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>

    <modules>
        <module>gitlet_core</module>
    </modules>

    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>

    <properties>
        <java.version>17</java.version>
    </properties>

    <!--
      This is an aggregator (packaging=pom), so it deliberately declares no
      <dependencies>.  Anything listed here is inherited by EVERY child module
      unconditionally, which is how gitlet_core ended up on
      spring-boot-starter-web / r2dbc despite being a plain library.  Each
      module now declares only what it uses; versions still come from
      spring-boot-starter-parent's BOM, so nothing needs repeating here.

      <build> is omitted for the same reason.  spring-boot-starter-parent already
      registers spring-boot-maven-plugin (with its repackage execution) in
      <pluginManagement>, so declaring it here would only switch it back on for
      every child.  The runnable module opts in from its own <build><plugins>.
    -->

</project>
